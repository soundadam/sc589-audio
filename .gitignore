# CCES / Eclipse workspace (if this tree is also the IDE workspace)
.metadata/
.recommenders/
RemoteSystemsTempFiles/
.CCES/

# Per-project Eclipse user prefs and debug launches
.settings/
*.launch

# CCES build configurations (SHARC + ARM/A5)
Debug/
Release/
debug/
release/

# SHARC toolchain artifacts (normally under Debug/Release; keep as a net)
*.doj
*.dlb
*.ldr
*.ovl
*.sm
*.map
*.xml.map

# Built executables
*.dxe

# ARM GCC leftovers that sometimes appear outside Debug/Release
*.o
*.d
*.elf
*.hex
*.i
*.srec
*.su

# Editor / OS
*~
*.bak
*.swp
*.tmp
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
*.code-workspace

# Loader streams copied back by host/build/remote_build.sh
/build/

# Python
__pycache__/
/.venv/

# Local settings, such as the report byline (Makefile)
/.env
